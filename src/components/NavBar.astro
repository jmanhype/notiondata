---
/**
 * NavBar Component
 *
 * Navigation header with menu, product links, search, cart, and sign-in options.
 * Uses TailwindCSS for styling.
 *
 * TODO: Add props for customizable links and dynamic content
 * TODO: Implement actual SVG icons for menu, search, and cart
 */
---

<!-- src/components/NavBar.astro -->
<header class="text-black">
  <nav class="flex justify-between items-center py-4">
    <!-- SVG for menu icon would go here -->
    <span>Menu</span>
    <div class="flex space-x-4">
      <a href="/">Product</a>
      <a href="/pricing">Pricing</a>
      <a href="/contact">Contact us</a>
    </div>
    <div class="flex space-x-4">
      <!-- SVGs for search and shopping cart icons would go here -->
      <span>Search</span>
      <span>Cart</span>
      <a href="/signin">Sign in</a>
    </div>
  </nav>
</header>
